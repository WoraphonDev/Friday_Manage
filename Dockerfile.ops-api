# Friday Ops API (หลังบ้าน) · โครงเดียวกับ Dockerfile.api แต่ไม่ต้อง migrate (ใช้ฐานข้อมูลเดียวกับ API ลูกค้า)
FROM node:22-bookworm AS build
WORKDIR /app
RUN npm install --global pnpm@10.34.5
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/ops-api/package.json apps/ops-api/package.json
COPY packages/db/package.json packages/db/package.json
RUN pnpm --filter @friday/ops-api... install --frozen-lockfile
COPY packages/db packages/db
COPY apps/ops-api apps/ops-api
RUN pnpm --filter @friday/ops-api build

# dependency สำหรับรันเท่านั้น · คงโครง workspace ไว้ เพราะ @friday/db ใช้ไฟล์ .ts ตรง ๆ (เหมือน Dockerfile.api)
FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN npm install --global pnpm@10.34.5
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/ops-api/package.json apps/ops-api/package.json
COPY packages/db/package.json packages/db/package.json
RUN pnpm --filter @friday/ops-api... install --frozen-lockfile --prod

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production \
    OPS_PORT=4001
WORKDIR /app
COPY --from=deps --chown=node:node /app ./
COPY --from=build --chown=node:node /app/apps/ops-api/dist ./apps/ops-api/dist
COPY --chown=node:node packages/db/src ./packages/db/src
USER node
WORKDIR /app/apps/ops-api
EXPOSE 4001
CMD ["node", "dist/main.js"]
