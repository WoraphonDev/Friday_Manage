{
  "name": "friday-manage",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @friday/db generate",
    "db:migrate": "pnpm --filter @friday/db migrate",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:dev-roles": "pnpm --filter @friday/db dev-roles",
    "api:dev": "pnpm --filter @friday/api dev",
    "typecheck": "pnpm -r typecheck"
  }
}
