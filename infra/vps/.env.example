# ค่าของเครื่อง VPS · setup-server.sh สร้าง /opt/friday/.env จากไฟล์นี้และสุ่ม secret ให้ (chmod 600) · ห้าม commit ไฟล์ .env จริง

# ชื่อเว็บ · ยังไม่มีโดเมน = ใช้ sslip.io (เปลี่ยนเป็น app.fridaymanage.com / ops.fridaymanage.com เมื่อจดแล้ว)
APP_HOST=app.203-0-113-10.sslip.io
OPS_HOST=ops.203-0-113-10.sslip.io

# รุ่นของ image ที่รันอยู่ · deploy.sh ตั้งให้เอง
TAG=

# ฐานข้อมูล (สุ่มตอน setup · ใช้ตัวอักษร/ตัวเลขล้วน เพราะประกอบเป็น URL ตรง ๆ)
DB_OWNER_PASSWORD=
DB_API_PASSWORD=
DB_WORKER_PASSWORD=

# กุญแจลงลายมือชื่อ (≥ 32 ตัวอักษร)
AUTH_SECRET=
OPS_AUTH_SECRET=
STRIPE_WEBHOOK_SECRET=
ETAX_WEBHOOK_SECRET=
EMAIL_FEEDBACK_TOKEN=

# ชำระเงิน · ยังไม่มี Gateway จริง (A35b) = fake · ตั้ง STRIPE_SECRET_KEY แล้วตัวจริงจะถูกใช้แทน
PAYMENT_GATEWAY=fake
STRIPE_SECRET_KEY=
VAT_REGISTERED=false

# อีเมล · ว่าง = ไม่ส่ง (เขียน log แทน) · ลิงก์ยืนยัน / รีเซ็ตรหัสผ่านจะไม่ถึงผู้ใช้
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# หลังบ้าน
OPS_JOBS=on
OPS_ACCOUNTING_EMAIL=
# Web Push · deploy.sh สร้างให้ครั้งแรก
OPS_VAPID_PUBLIC_KEY=
OPS_VAPID_PRIVATE_KEY=

# GlitchTip (ว่าง = ปิด)
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
