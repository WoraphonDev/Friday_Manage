# เจ้าของตาราง ใช้รัน migration เท่านั้น
DATABASE_OWNER_URL=postgres://friday_owner:friday_owner_dev@localhost:54329/friday
# บัญชีที่ API ใช้ตอนทำงาน (สมาชิกของ role friday_app ถูกบังคับด้วย RLS)
DATABASE_APP_URL=postgres://friday_api:friday_api_dev@localhost:54329/friday
# บัญชีของงานเบื้องหลัง / Auth (BYPASSRLS)
DATABASE_SYSTEM_URL=postgres://friday_worker:friday_worker_dev@localhost:54329/friday

# ชำระเงิน · Stripe (A35b · ผู้ใช้เลือก 24 พ.ย. 2569) · ไม่ตั้ง STRIPE_SECRET_KEY = ตัวจำลอง (dev / test) · ห้าม commit คีย์จริง
# คีย์ทดสอบ sk_test_… จาก Stripe Dashboard (Test mode) · Webhook ในเครื่อง: stripe listen --forward-to localhost:3001/api/v1/hooks/stripe แล้วใช้ whsec_… ที่ CLI พิมพ์
# Event ที่ต้องส่ง: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ไม่บังคับ: ปลายทาง API อื่น (เช่น stripe-mock) · ใช้ได้เฉพาะนอก production
STRIPE_API_URL=
# staging ที่รันแบบ production แต่ยังไม่มีคีย์: PAYMENT_GATEWAY=fake + STRIPE_WEBHOOK_SECRET ≥ 32 ตัวอักษร
PAYMENT_GATEWAY=
